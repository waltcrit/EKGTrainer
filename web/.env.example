# Required — Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the Claude model (defaults to claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Required for the Analyze tab on user-uploaded images (not needed for training cases)
# Set to your Railway service URL in production, or http://localhost:8000 for local dev
PYTHON_SERVICE_URL=http://localhost:8000
