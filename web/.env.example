# Required — Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the Claude model (defaults to claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional — Python ECG digitization service URL.
# If omitted, uploaded ECGs are analyzed via direct Claude vision (less precise).
# Set to your Railway/Render/Fly service URL in production, or http://localhost:8000 locally.
# PYTHON_SERVICE_URL=https://your-python-service.railway.app
