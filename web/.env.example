# Optional — Python ECG digitization + measurement service (defaults to http://localhost:8000).
# Set to your Railway/Render/Fly URL in production.
# PYTHON_SERVICE_URL=http://localhost:8000

# Optional (recommended in production) — shared secret for the Python service.
# If set on the web side, set the same value as PYTHON_API_KEY on the Python service.
# PYTHON_API_KEY=your_random_long_secret
