# Copy this file to .env.local and fill in your Anthropic API key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional — Python ECG digitization service URL (defaults to http://localhost:8000)
# PYTHON_SERVICE_URL=http://localhost:8000

# Optional (recommended) — shared secret for the Python service.
# Use the same value as PYTHON_API_KEY on the python service.
# PYTHON_API_KEY=your_random_long_secret
